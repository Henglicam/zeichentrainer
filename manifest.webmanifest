{
  "name": "识字 Shízì",
  "short_name": "识字",
  "description": "Chinese character trainer with spaced repetition",
  "start_url": ".",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2F2F7",
  "theme_color": "#F2F2F7",
  "lang": "en",
